<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="../GlassTheme.uss" />
    <ui:Style src="Player.uss" />
    
    <ui:VisualElement name="Root" picking-mode="Ignore" style="flex-grow: 1; justify-content: center; align-items: center;">
        
        <!-- Inventory (Initially Hidden) -->
        <ui:VisualElement name="InventoryPanel" class="glass-panel" style="width: 600px; height: 500px; display: none; justify-content: flex-start; padding: 20px;">
            <ui:Label text="INVENTORY" class="glass-text" style="font-size: 24px; margin-bottom: 20px; align-self: center;" />
            <ui:ScrollView style="flex-grow: 1;">
                <ui:VisualElement name="InventoryGrid" class="inventory-grid" style="flex-direction: row; flex-wrap: wrap; justify-content: flex-start; align-content: flex-start;" />
            </ui:ScrollView>
            
            <!-- Optional: Stats panel -->
            <ui:VisualElement style="margin-top: 15px; padding-top: 10px; border-top-width: 1px; border-top-color: rgba(255,255,255,0.2); flex-direction: row; justify-content: space-between;">
                <ui:Label name="GoldTotal" text="💰 Gold: 0" style="font-size: 14px;" />
                <ui:Label name="WaterTotal" text="💧 Water: 0" style="font-size: 14px;" />
                <ui:Label name="ItemsTotal" text="📦 Items: 0" style="font-size: 14px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Interaction Prompt (Contextual) -->
        <ui:VisualElement name="InteractionPrompt" class="glass-panel" style="position: absolute; bottom: 20%; align-items: center; flex-direction: row; padding: 15px; border-radius: 30px; display: none;">
            <ui:VisualElement class="key-hint glass-button" style="width: 40px; height: 40px; justify-content: center; align-items: center; margin-right: 15px; border-radius: 20px;">
                <ui:Label text="E" style="font-size: 20px; -unity-font-style: bold;" />
            </ui:VisualElement>
            <ui:Label name="InteractionLabel" text="Harvest Plant" class="glass-text" style="font-size: 18px;" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>