/* Inventory Grid Styles */
.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    padding: 10px;
}

.inventory-slot {
    width: 80px;
    height: 80px;
    margin: 5px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    transition: all 0.2s ease;
    position: relative;
    cursor: pointer;
}

.inventory-slot:hover {
    background-color: rgba(100, 100, 100, 0.8);
    border-color: rgba(255, 215, 0, 0.8);
    transform: scale(1.05);
}

.inventory-slot .item-icon {
    width: 50px;
    height: 50px;
    margin-bottom: 5px;
    border-radius: 5px;
}

.inventory-slot .amount-label {
    position: absolute;
    bottom: 5px;
    right: 5px;
    font-size: 12px;
    color: white;
    font-weight: bold;
    text-shadow: 1px 1px 0 black;
}

.inventory-slot .name-label {
    position: absolute;
    top: 5px;
    left: 5px;
    font-size: 10px;
    color: white;
    display: none;
    text-shadow: 1px 1px 0 black;
}

.inventory-slot:hover .name-label {
    display: flex;
}

/* Item Type Colors */
.item-gold { background-color: gold; }
.item-water { background-color: cyan; }
.item-seed { background-color: lightgreen; }
.item-tool { background-color: gray; }
.item-food { background-color: orange; }
.item-material { background-color: brown; }