<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GlassTheme.uss?fileID=7433441132597879392&amp;guid=03998e6826707b944954e041c886f580&amp;type=3#GlassTheme"/>
    <Style src="project://database/Assets/UI%20Toolkit/HUD/HUD.uss?fileID=7433441132597879392&amp;guid=1ca10815095676f48a1cf3f6b213ff0c&amp;type=3#HUD"/>
    <ui:VisualElement name="Root" picking-mode="Ignore" style="flex-grow: 1; justify-content: space-between; flex-direction: column; padding: 20px;">
        <ui:VisualElement name="TopRow" style="flex-direction: row; justify-content: space-between; align-items: flex-start; width: 100%;">
            <ui:VisualElement name="CurrencyContainer" class="glass-panel" style="flex-direction: column; align-items: flex-start; min-width: 150px; display: none;">
                <ui:Label text="RESOURCES" class="glass-text" style="font-size: 14px; opacity: 0.8; margin-bottom: 5px;"/>
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 5px;">
                    <ui:VisualElement class="currency-icon" style="background-color: gold; width: 24px; height: 24px; border-radius: 12px; margin-right: 8px;"/>
                    <ui:Label text="1,250 Gold" class="glass-text" style="font-size: 18px;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:VisualElement class="currency-icon" style="background-color: rgb(100, 255, 100); width: 24px; height: 24px; border-radius: 12px; margin-right: 8px;"/>
                    <ui:Label text="50 Seeds" class="glass-text" style="font-size: 18px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="PauseButton" text="⏸" style="font-size: 32px; align-items: center; justify-content: center; padding: 0; background-color: transparent; border-width: 0; color: white;"/>
            <ui:VisualElement name="StatusContainer" class="glass-panel" style="min-width: 160px; padding: 12px 16px; flex-direction: column; align-items: stretch;">
                <ui:Label name="TimeLabel" text="06:13" class="glass-text" style="font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 8px;"/>
                <ui:VisualElement name="HealthRow" style="flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                    <ui:Image name="HealthIcon" scale-mode="ScaleToFit" style="width: 48px; height: 48px; background-image: url(&quot;project://database/Assets/Images/UI/Health.png?fileID=2800000&amp;guid=c23d236f16fe34e289c4bd30bbb8aae6&amp;type=3#Health&quot;);"/>
                    <ui:Label name="HealthValue" text="100%" class="glass-text" style="font-size: 18px; -unity-font-style: bold; margin-left: 12px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="OxygenRow" style="flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                    <ui:Image name="OxygenIcon" scale-mode="ScaleToFit" style="width: 48px; height: 48px; background-image: url(&quot;project://database/Assets/Images/UI/oxygen.png?fileID=2800000&amp;guid=dfef83af696714453b73e8eb7ea99c7e&amp;type=3#oxygen&quot;);"/>
                    <ui:Label name="OxygenValue" text="92%" class="glass-text" style="font-size: 18px; -unity-font-style: bold; margin-left: 12px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="StaminaRow" style="flex-direction: row; align-items: center; justify-content: space-between;">
                    <ui:Image name="StaminaIcon" scale-mode="ScaleToFit" style="width: 48px; height: 48px; background-image: url(&quot;project://database/Assets/Images/UI/energy.png?fileID=2800000&amp;guid=78f27832fcd644866a1fa3c34176a480&amp;type=3#energy&quot;);"/>
                    <ui:Label name="StaminaValue" text="80%&#10;" class="glass-text" style="font-size: 18px; -unity-font-style: bold; margin-left: 12px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SeedsDisplay" style="position: absolute; left: 20px; top: 50%; flex-direction: column; align-items: flex-start; display: none;">
            <ui:VisualElement name="SeedsContainer" style="flex-direction: column;"/>
        </ui:VisualElement>
        <ui:VisualElement name="MapContainer" class="glass-panel" style="position: absolute; top: auto; right: auto; width: 300px; height: 300px; padding: 0; align-items: center; justify-content: center; border-top-left-radius: 150px; border-top-right-radius: 150px; border-bottom-right-radius: 150px; border-bottom-left-radius: 150px; border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); left: 2%; bottom: 3%;">
            <ui:VisualElement name="MapMask" style="width: 100%; height: 100%; overflow: hidden; background-color: rgba(0, 0, 0, 0.3); border-top-left-radius: 140px; border-top-right-radius: 140px; border-bottom-right-radius: 140px; border-bottom-left-radius: 140px;">
                <ui:Label text="MINIMAP" style="color: rgba(255, 255, 255, 0.5); align-self: center; top: 45%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomRow" style="flex-direction: row; justify-content: center; align-items: flex-end; width: 100%; margin-top: auto; margin-bottom: 70px; padding-left: 360px; padding-right: 320px;">
            <ui:VisualElement name="HotbarContainer" class="glass-panel" style="flex-direction: row; justify-content: center; padding: 10px; border-radius: 15px; align-items: center; height: 102px; align-self: center; width: 740px; min-width: 740px; flex-shrink: 0;">
                <ui:VisualElement class="hotbar-slot active-slot" style="width: 60px; height: 60px; flex-shrink: 0; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="1" class="slot-number" style="position: absolute; bottom: -22px; left: 0; right: 0; font-size: 14px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.9); top: auto;"/>
                    <ui:VisualElement class="item-icon" style="width: 32px; height: 32px;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; flex-shrink: 0; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="2" class="slot-number" style="position: absolute; bottom: -22px; left: 0; right: 0; font-size: 14px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.9); top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; flex-shrink: 0; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="3" class="slot-number" style="position: absolute; bottom: -22px; left: 0; right: 0; font-size: 14px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.9); top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; flex-shrink: 0; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="4" class="slot-number" style="position: absolute; bottom: -22px; left: 0; right: 0; font-size: 14px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.9); top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; flex-shrink: 0; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="5" class="slot-number" style="position: absolute; bottom: -22px; left: 0; right: 0; font-size: 14px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.9); top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; flex-shrink: 0; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="6" class="slot-number" style="position: absolute; bottom: -22px; left: 0; right: 0; font-size: 14px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.9); top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; flex-shrink: 0; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="7" class="slot-number" style="position: absolute; bottom: -22px; left: 0; right: 0; font-size: 14px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.9); top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; flex-shrink: 0; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="8" class="slot-number" style="position: absolute; bottom: -22px; left: 0; right: 0; font-size: 14px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.9); top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; flex-shrink: 0; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="9" class="slot-number" style="position: absolute; bottom: -22px; left: 0; right: 0; font-size: 14px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.9); top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; flex-shrink: 0; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="10" class="slot-number" style="position: absolute; bottom: -22px; left: 0; right: 0; font-size: 14px; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.9); top: auto;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="MessageLabel" text="" style="display: flex; position: absolute; bottom: 200px; left: 0; right: auto; align-self: center; width: 300px; -unity-text-align: middle-center; color: white; font-size: 18px; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0.7); padding: 10px 20px; border-radius: 5px; height: 78px; visibility: hidden;"/>
        <ui:VisualElement name="ResourceContainer" style="position: absolute; bottom: 7%; right: 30px; left: auto; flex-direction: column; align-items: center;">
            <ui:VisualElement style="flex-direction: row; align-items: flex-end; justify-content: center;">
                <ui:VisualElement style="flex-direction: column; align-items: center; margin-right: 24px;">
                    <ui:Label name="GoldLabel" text="G" style="color: rgb(255, 255, 255); font-size: 20px; -unity-font-style: bold; margin-bottom: 4px; opacity: 0.9;"/>
                    <ui:Image name="GoldIcon" scale-mode="ScaleToFit" style="width: 70px; height: 70px; background-image: url(&quot;project://database/Assets/Images/UI/Gold.png?fileID=2800000&amp;guid=8beeb81d600d649539631a877b58a69c&amp;type=3#Gold&quot;);"/>
                    <ui:Label name="GoldValue" text="0" style="color: rgb(255, 255, 255); font-size: 18px; -unity-font-style: bold; margin-top: 4px;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: column; align-items: center; margin-right: 24px;">
                    <ui:Label name="WaterLabel" text="W" style="color: rgb(255, 255, 255); font-size: 20px; -unity-font-style: bold; margin-bottom: 4px; opacity: 0.9;"/>
                    <ui:Image name="WaterIcon" scale-mode="ScaleToFit" style="width: 70px; height: 70px; background-image: url(&quot;project://database/Assets/Images/UI/water.png?fileID=2800000&amp;guid=2586216b8351642f192d92787f63019b&amp;type=3#water&quot;);"/>
                    <ui:Label name="WaterValue" text="0" style="color: rgb(255, 255, 255); font-size: 18px; -unity-font-style: bold; margin-top: 4px;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: column; align-items: center;">
                    <ui:Label name="ClayLabel" text="C" style="color: rgb(255, 255, 255); font-size: 20px; -unity-font-style: bold; margin-bottom: 4px; opacity: 0.9;"/>
                    <ui:Image name="ClayIcon" scale-mode="ScaleToFit" style="width: 70px; height: 70px; background-image: url(&quot;project://database/Assets/Images/UI/clay.png?fileID=2800000&amp;guid=310e8df487a244910b91f6c138a0ae41&amp;type=3#clay&quot;);"/>
                    <ui:Label name="ClayValue" text="0" style="color: rgb(255, 255, 255); font-size: 18px; -unity-font-style: bold; margin-top: 4px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
