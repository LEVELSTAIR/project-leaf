<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GlassTheme.uss?fileID=7433441132597879392&amp;guid=03998e6826707b944954e041c886f580&amp;type=3#GlassTheme"/>
    <Style src="project://database/Assets/UI%20Toolkit/HUD/HUD.uss?fileID=7433441132597879392&amp;guid=1ca10815095676f48a1cf3f6b213ff0c&amp;type=3#HUD"/>
    <ui:VisualElement name="Root" picking-mode="Ignore" style="flex-grow: 1; justify-content: space-between; flex-direction: column; padding: 20px;">
        <ui:VisualElement name="TopRow" style="flex-direction: row; justify-content: space-between; align-items: flex-start; width: 100%;">
            <ui:VisualElement name="CurrencyContainer" class="glass-panel" style="flex-direction: column; align-items: flex-start; min-width: 150px; display: none;">
                <ui:Label text="RESOURCES" class="glass-text" style="font-size: 14px; opacity: 0.8; margin-bottom: 5px;"/>
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 5px;">
                    <ui:VisualElement class="currency-icon" style="background-color: gold; width: 24px; height: 24px; border-radius: 12px; margin-right: 8px;"/>
                    <ui:Label text="1,250 Gold" class="glass-text" style="font-size: 18px;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:VisualElement class="currency-icon" style="background-color: rgb(100, 255, 100); width: 24px; height: 24px; border-radius: 12px; margin-right: 8px;"/>
                    <ui:Label text="50 Seeds" class="glass-text" style="font-size: 18px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="PauseButton" text="⏸" style="font-size: 32px; align-items: center; justify-content: center; padding: 0; background-color: transparent; border-width: 0; color: white;"/>
            <ui:VisualElement name="ClockContainer" class="glass-panel clock-panel" style="padding: 10px; justify-content: center; align-items: center;">
                <ui:Label name="TimeLabel" text="12:00" class="glass-text" style="font-size: 24px; font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="StatusContainer" class="glass-panel" style="width: 300px; padding: 15px; flex-direction: column; justify-content: flex-end;">
                <ui:VisualElement name="HealthGroup" style="margin-bottom: 10px;">
                    <ui:Label text="HEALTH" class="glass-text" style="font-size: 12px; margin-bottom: 2px; opacity: 0.8;"/>
                    <ui:VisualElement class="bar-background" style="background-color: rgba(0, 0, 0, 0.5); height: 20px; border-radius: 10px; overflow: hidden;">
                        <ui:VisualElement name="HealthFill" class="bar-fill health-fill" style="width: 80%; height: 100%; background-color: red; border-radius: 10px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="OxygenGroup" style="margin-bottom: 10px;">
                    <ui:Label text="OXYGEN" class="glass-text" style="font-size: 12px; margin-bottom: 2px; opacity: 0.8;"/>
                    <ui:VisualElement class="bar-background" style="background-color: rgba(0, 0, 0, 0.5); height: 20px; border-radius: 10px; overflow: hidden;">
                        <ui:VisualElement name="OxygenFill" class="bar-fill oxygen-fill" style="width: 100%; height: 100%; background-color: cyan; border-radius: 10px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="StaminaGroup">
                    <ui:Label text="STAMINA" class="glass-text" style="font-size: 12px; margin-bottom: 2px; opacity: 0.8;"/>
                    <ui:VisualElement class="bar-background" style="background-color: rgba(0, 0, 0, 0.5); height: 20px; border-radius: 10px; overflow: hidden;">
                        <ui:VisualElement name="StaminaFill" class="bar-fill stamina-fill" style="width: 60%; height: 100%; background-color: green; border-radius: 10px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SeedsDisplay" style="position: absolute; left: 20px; top: 50%; flex-direction: column; align-items: flex-start;">
            <ui:VisualElement name="SeedsContainer" style="flex-direction: column;"/>
        </ui:VisualElement>
        <ui:VisualElement name="MapContainer" class="glass-panel" style="position: absolute; top: auto; right: auto; width: 300px; height: 300px; padding: 0; align-items: center; justify-content: center; border-top-left-radius: 150px; border-top-right-radius: 150px; border-bottom-right-radius: 150px; border-bottom-left-radius: 150px; border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); left: 5%; bottom: 5%;">
            <ui:VisualElement name="MapMask" style="width: 100%; height: 100%; overflow: hidden; background-color: rgba(0, 0, 0, 0.3); border-top-left-radius: 140px; border-top-right-radius: 140px; border-bottom-right-radius: 140px; border-bottom-left-radius: 140px;">
                <ui:Label text="MINIMAP" style="color: rgba(255, 255, 255, 0.5); align-self: center; top: 45%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomRow" style="flex-direction: row; justify-content: center; align-items: flex-end; width: 100%; margin-top: auto;">
            <ui:VisualElement name="HotbarContainer" class="glass-panel" style="flex-direction: row; justify-content: center; padding: 10px; border-radius: 15px; align-content: center; align-items: center; height: 80px;">
                <ui:VisualElement class="hotbar-slot active-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="1" class="slot-number" style="position: absolute; bottom: 0%; right: auto; font-size: 12px; left: auto; top: auto;"/>
                    <ui:VisualElement class="item-icon" style="width: 32px; height: 32px;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="2" class="slot-number" style="position: absolute; bottom: 0%; font-size: 12px; left: auto; top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="3" class="slot-number" style="position: absolute; bottom: 0%; font-size: 12px; left: auto; top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="4" class="slot-number" style="position: absolute; bottom: 0%; font-size: 12px; top: auto; left: auto; right: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="5" class="slot-number" style="position: absolute; bottom: 0%; font-size: 12px; left: auto; top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="6" class="slot-number" style="position: absolute; bottom: 0%; font-size: 12px; left: auto; top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="7" class="slot-number" style="position: absolute; bottom: 0%; font-size: 12px; left: auto; top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="8" class="slot-number" style="position: absolute; bottom: 0%; font-size: 12px; left: auto; top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="9" class="slot-number" style="position: absolute; bottom: 0%; font-size: 12px; left: auto; top: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="10" class="slot-number" style="position: absolute; bottom: 0%; font-size: 12px; left: auto; top: auto;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ResourceContainer" style="position: absolute; bottom: 20%; left: auto; right: 5%; flex-direction: row; align-items: center; justify-content: center;">
            <ui:VisualElement style="flex-direction: column; align-items: center; margin-right: 20px;">
                <ui:Label name="GoldLabel" text="G" style="color: rgb(255, 255, 255); font-size: 40px; -unity-font-style: bold; margin-bottom: 6px;"/>
                <ui:Image name="GoldIcon" scale-mode="StretchToFill" style="width: 140px; height: 140px; background-image: url(&quot;project://database/Assets/Images/UI/Gold.png?fileID=2800000&amp;guid=8beeb81d600d649539631a877b58a69c&amp;type=3#Gold&quot;);"/>
                <ui:Label name="GoldValue" text="0" style="color: rgb(255, 255, 255); font-size: 22px; -unity-font-style: bold; margin-top: 6px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: column; align-items: center; margin-right: 20px;">
                <ui:Label name="WaterLabel" text="W" style="color: rgb(255, 255, 255); font-size: 40px; -unity-font-style: bold; margin-bottom: 6px;"/>
                <ui:Image name="WaterIcon" style="width: 128px; height: 128px; background-image: url(&quot;project://database/Assets/Images/UI/water.png?fileID=2800000&amp;guid=2586216b8351642f192d92787f63019b&amp;type=3#water&quot;);"/>
                <ui:Label name="WaterValue" text="0" style="color: rgb(255, 255, 255); font-size: 22px; -unity-font-style: bold; margin-top: 6px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: column; align-items: center;">
                <ui:Label name="ClayLabel" text="C" style="color: rgb(255, 255, 255); font-size: 40px; -unity-font-style: bold; margin-bottom: 6px;"/>
                <ui:Image name="ClayIcon" style="width: 128px; height: 128px; background-image: url(&quot;project://database/Assets/Images/UI/clay.png?fileID=2800000&amp;guid=310e8df487a244910b91f6c138a0ae41&amp;type=3#clay&quot;);"/>
                <ui:Label name="ClayValue" text="0" style="color: rgb(255, 255, 255); font-size: 22px; -unity-font-style: bold; margin-top: 6px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="MessageLabel" text="" style="display: flex; position: absolute; bottom: 34px; right: 20px; width: 300px; -unity-text-align: middle-center; color: white; font-size: 18px; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0.7); padding: 10px 20px; border-radius: 5px; height: 78px; visibility: hidden;"/>
    </ui:VisualElement>
</ui:UXML>
