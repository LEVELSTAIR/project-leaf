<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GlassTheme.uss?fileID=7433441132597879392&amp;guid=03998e6826707b944954e041c886f580&amp;type=3#GlassTheme"/>
    <Style src="project://database/Assets/UI%20Toolkit/HUD/HUD.uss?fileID=7433441132597879392&amp;guid=1ca10815095676f48a1cf3f6b213ff0c&amp;type=3#HUD"/>
    <ui:VisualElement name="Root" picking-mode="Ignore" style="flex-grow: 1; justify-content: space-between; flex-direction: column; padding: 20px;">
        <ui:VisualElement name="TopRow" style="flex-direction: row; justify-content: space-between; align-items: flex-start; width: 100%;">
            <ui:VisualElement name="CurrencyContainer" class="glass-panel" style="flex-direction: column; align-items: flex-start; min-width: 150px; display: none;">
                <ui:Label text="RESOURCES" class="glass-text" style="font-size: 14px; opacity: 0.8; margin-bottom: 5px;"/>
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 5px;">
                    <ui:VisualElement class="currency-icon" style="background-color: gold; width: 24px; height: 24px; border-radius: 12px; margin-right: 8px;"/>
                    <ui:Label text="1,250 Gold" class="glass-text" style="font-size: 18px;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:VisualElement class="currency-icon" style="background-color: rgb(100, 255, 100); width: 24px; height: 24px; border-radius: 12px; margin-right: 8px;"/>
                    <ui:Label text="50 Seeds" class="glass-text" style="font-size: 18px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="InventoryPanel" class="glass-panel" style="height: auto; min-width: 150px; padding: 10px;">
                <ui:Label name="GoldLabel" text="💰 Gold: 0" style="margin-bottom: 5px;"/>
                <ui:Label name="WaterLabel" text="💧 Water: 0" style="margin-bottom: 5px;"/>
                <ui:VisualElement name="SeedsContainer" style="margin-top: 5px; display: none;"/>
            </ui:VisualElement>
            <ui:VisualElement name="TopRightGroup" style="flex-direction: row; align-items: center;">
                <ui:VisualElement name="ClockContainer" class="glass-panel clock-panel" style="margin-right: 15px; padding: 10px; justify-content: center; align-items: center; position: absolute; top: 5px; left: -108px;">
                    <ui:Label name="TimeLabel" text="12:00" class="glass-text" style="font-size: 24px; font-style: bold;"/>
                </ui:VisualElement>
                <ui:VisualElement name="MapContainer" class="glass-panel" style="width: 200px; height: 200px; padding: 0; align-items: center; justify-content: center;">
                    <ui:VisualElement name="MapMask" style="width: 100%; height: 100%; overflow: hidden; border-radius: 12px; background-color: rgba(0, 0, 0, 0.3); position: absolute;">
                        <ui:Label text="MINIMAP" style="color: rgba(255, 255, 255, 0.5); align-self: center; top: 45%;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomRow" style="flex-direction: row; justify-content: space-between; align-items: flex-end; width: 100%; margin-top: auto;">
            <ui:VisualElement name="StatusContainer" class="glass-panel" style="width: 300px; padding: 15px; flex-direction: column; justify-content: flex-end;">
                <ui:VisualElement name="HealthGroup" style="margin-bottom: 10px;">
                    <ui:Label text="HEALTH" class="glass-text" style="font-size: 12px; margin-bottom: 2px; opacity: 0.8;"/>
                    <ui:VisualElement class="bar-background" style="background-color: rgba(0, 0, 0, 0.5); height: 20px; border-radius: 10px; overflow: hidden;">
                        <ui:VisualElement name="HealthFill" class="bar-fill health-fill" style="width: 80%; height: 100%; background-color: red; border-radius: 10px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="OxygenGroup" style="margin-bottom: 10px;">
                    <ui:Label text="OXYGEN" class="glass-text" style="font-size: 12px; margin-bottom: 2px; opacity: 0.8;"/>
                    <ui:VisualElement class="bar-background" style="background-color: rgba(0, 0, 0, 0.5); height: 20px; border-radius: 10px; overflow: hidden;">
                        <ui:VisualElement name="OxygenFill" class="bar-fill oxygen-fill" style="width: 100%; height: 100%; background-color: cyan; border-radius: 10px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="StaminaGroup">
                    <ui:Label text="STAMINA" class="glass-text" style="font-size: 12px; margin-bottom: 2px; opacity: 0.8;"/>
                    <ui:VisualElement class="bar-background" style="background-color: rgba(0, 0, 0, 0.5); height: 20px; border-radius: 10px; overflow: hidden;">
                        <ui:VisualElement name="StaminaFill" class="bar-fill stamina-fill" style="width: 60%; height: 100%; background-color: green; border-radius: 10px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="HotbarContainer" class="glass-panel" style="position: absolute; bottom: 18px; left: 410px; right: 359px; flex-direction: row; justify-content: center; padding: 10px; border-radius: 15px; margin: 0 auto; align-content: center; align-self: center; align-items: center;">
                <ui:VisualElement class="hotbar-slot active-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="1" class="slot-number" style="position: absolute; bottom: 2px; right: 5px; font-size: 12px;"/>
                    <ui:VisualElement class="item-icon" style="width: 32px; height: 32px;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="2" class="slot-number" style="position: absolute; bottom: 2px; right: 5px; font-size: 12px;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="3" class="slot-number" style="position: absolute; bottom: 2px; right: 5px; font-size: 12px;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="4" class="slot-number" style="position: absolute; bottom: 2px; right: 5px; font-size: 12px;"/>
                </ui:VisualElement>
                <ui:VisualElement class="hotbar-slot" style="width: 60px; height: 60px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.6); border-radius: 8px; align-items: center; justify-content: center;">
                    <ui:Label text="5" class="slot-number" style="position: absolute; bottom: 2px; right: 5px; font-size: 12px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="width: 100px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="InteractionContainer" style="display: flex; position: absolute; bottom: 129px; left: 474px; right: 408px; align-items: center; top: auto; height: 69px; background-color: rgba(0, 0, 0, 0);">
            <ui:VisualElement style="background-color: rgba(0, 0, 0, 0); padding: 12px 24px; border-radius: 8px;">
                <ui:Label name="InteractionPrompt" text="Press E to interact" style="color: white; font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="MessageLabel" text="" style="display: flex; position: absolute; bottom: 34px; left: 1075px; right: 3px; -unity-text-align: middle-center; color: white; font-size: 18px; -unity-font-style: bold; background-color: rgba(0, 0, 0, 0.7); padding: 10px 20px; border-radius: 5px; height: 78px; visibility: hidden;"/>
    </ui:VisualElement>
</ui:UXML>
